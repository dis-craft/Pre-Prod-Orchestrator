{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityFinding",
  "type": "object",
  "required": ["id", "tool", "rule", "severity", "file", "line", "message", "confidence"],
  "properties": {
    "id": {"type": "string"},
    "tool": {"type": "string"},
    "rule": {"type": "string"},
    "severity": {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "file": {"type": "string"},
    "line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "message": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "fixability": {"type": "string", "enum": ["AUTO", "AI_ASSISTED", "HUMAN_ONLY", "UNKNOWN"]},
    "metadata": {"type": "object", "additionalProperties": true},
    "cwe": {"type": "string", "description": "CWE identifier number"},
    "category": {"type": "string", "description": "Vulnerability category"},
    "what_and_why": {"type": "string", "description": "Vulnerability description, attacker impact, and potential damage"},
    "location_detail": {"type": "string", "description": "Exact location with code context snippet"},
    "how_to_fix": {"type": "string", "description": "Step-by-step remediation instructions"},
    "why_fix_helps": {"type": "string", "description": "Why the fix mitigates the security risk"},
    "llm_confirmed": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"}
      ],
      "description": "Whether an LLM confirmed this finding. Null if no LLM was used."
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1}
        },
        "required": ["file", "line"]
      },
      "description": "All locations in the repo where this vulnerability pattern appears"
    }
  },
  "additionalProperties": false
}
